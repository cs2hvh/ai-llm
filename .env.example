# Copy to `.env` and fill in. Never commit `.env`.

# Hugging Face — model + dataset hub
HF_TOKEN=

# RunPod — compute orchestration
RUNPOD_API_KEY=

# Weights & Biases — experiment tracking (or use MLflow instead)
WANDB_API_KEY=
WANDB_PROJECT=myllm
WANDB_ENTITY=

# S3-compatible object storage — checkpoints + datasets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=          # e.g. https://<account>.r2.cloudflarestorage.com
S3_BUCKET=myllm-artifacts

# Keras backend — keep "jax" for training; switch to "tensorflow" for TF inference
KERAS_BACKEND=jax
